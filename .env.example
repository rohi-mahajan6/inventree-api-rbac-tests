# Copy to .env for local runs. .env is gitignored. In CI this comes from the repository secret
# INVENTREE_DEMO_PASSWORDS. Passwords are the published demo accounts (docs.inventree.org/en/stable/demo/).

# Local runs only target the public demo (read-only safe probes). The Docker suite runs in CI only.
INVENTREE_BASE_URL=https://demo.inventree.org
INVENTREE_TARGET=public

# JSON object: username -> password. Public suite needs allaccess, reader, engineer, noaccess, ian.
# The Docker suite also needs steven and admin.
INVENTREE_DEMO_PASSWORDS={"allaccess":"","reader":"","engineer":"","noaccess":"","ian":""}
